{
  "manifest_version": 3,
  "name": "Media Grabber (MV3)",
  "version": "1.0.0",
  "description": "Chrome extension to get the media URL of a page's most recently played audio/video.",
  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon/icon16.png",
      "24": "icon/icon24.png",
      "32": "icon/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Media Grabber",
  },
  
    "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.js"
  }
}
